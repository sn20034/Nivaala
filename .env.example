# Nivaala frontend environment variables
# Copy this file to `.env` and fill in your values.

# Spring Boot REST API base URL (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8080/api

# Mock mode: set to "true" for mock data (frontend only), "false" to call the real API
VITE_USE_MOCK=true

# WhatsApp link for the floating button and menu opt-in
VITE_WHATSAPP_LINK=https://wa.me/919000000000
